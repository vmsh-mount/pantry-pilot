# ─────────────────────────────────────────────────────────────────────────────
# PantryPilot — Pilot (backend) environment variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
# When running via docker-compose, host = "postgres" (service name)
# When running locally (no Docker), host = "localhost"
DATABASE_URL=postgresql+asyncpg://pantrypilot:pantrypilot@postgres:5432/pantrypilot

# ── Redis ─────────────────────────────────────────────────────────────────────
# When running via docker-compose, host = "redis"
REDIS_URL=redis://redis:6379/0

# ── Swiggy MCP OAuth ──────────────────────────────────────────────────────────
# Issued by Swiggy Builders Club on agreement approval
SWIGGY_MCP_BASE_URL=https://mcp.swiggy.com
SWIGGY_CLIENT_ID=your_swiggy_client_id_here
# Must match the redirect URI registered with Swiggy exactly
SWIGGY_REDIRECT_URI=http://localhost:3000/auth/callback

# ── Token encryption ──────────────────────────────────────────────────────────
# AES-256-GCM key: exactly 64 hex characters (= 32 bytes)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Interakt (WhatsApp BSP) ───────────────────────────────────────────────────
# Interakt dashboard → Developer → API Keys
INTERAKT_API_KEY=your_interakt_api_key_here
# Set in Interakt dashboard → Webhooks → Secret
INTERAKT_WEBHOOK_SECRET=your_webhook_secret_here
PANTRYPILOT_WHATSAPP_NUMBER=+91XXXXXXXXXX

# ── JWT / session ─────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY_HOURS=24

# ── Internal service secret ───────────────────────────────────────────────────
INTERNAL_API_SECRET=

# ── Provider selection ────────────────────────────────────────────────────────
# Leave blank to auto-select: APP_ENV=local -> all mocks, else -> real providers
LLM_PROVIDER=           # anthropic | gemini | mock
WHATSAPP_PROVIDER=      # interakt | mock
MCP_PROVIDER=           # swiggy | mock
OTP_PROVIDER=           # redis | mock

# ── Google Gemini (alternative LLM) ──────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Mock MCP server ───────────────────────────────────────────────────────────
MOCK_MCP_BASE_URL=http://localhost:8001

# ── Monitoring (optional) ─────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=DEBUG
